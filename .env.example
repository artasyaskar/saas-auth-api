# ==================== Application ====================
APP_NAME=SaaS Auth API
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== Database ====================
DATABASE_URL=postgresql://user:password@localhost:5432/saas_auth_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=localhost:7000,localhost:7001,localhost:7002
REDIS_POOL_SIZE=50
REDIS_PASSWORD=

# ==================== Elasticsearch ====================
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=saas_auth

# ==================== OAuth2/OIDC ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/v1/auth/oauth/github/callback

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=http://localhost:8000/v1/auth/oauth/apple/callback

# ==================== Two-Factor Authentication ====================
2FA_ISSUER=SaaS Auth API
2FA_DIGITS=6

# ==================== Email ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@saas-auth-api.com
SMTP_USE_TLS=true

SENDGRID_API_KEY=
SENDGRID_FROM=noreply@saas-auth-api.com

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=noreply@saas-auth-api.com

# ==================== Stripe ====================
STRIPE_API_KEY=sk_test_your_stripe_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ==================== AWS S3 ====================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=

# ==================== File Storage ====================
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# ==================== Monitoring ====================
ENABLE_METRICS=true
METRICS_PATH=/metrics
ENABLE_TRACING=true
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# ==================== Security ====================
ENABLE_RATE_LIMITING=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ALGORITHM=sliding_window
RATE_LIMIT_DEFAULT=100

# ==================== Feature Flags ====================
FEATURE_FLAGS_ENABLED=true
FEATURE_FLAGS_CACHE_TTL=300

# ==================== Geolocation ====================
GEOLOCATION_PROVIDER=ipinfo
IPINFO_API_KEY=

# ==================== Webhooks ====================
WEBHOOK_TIMEOUT=30
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF=exponential

# ==================== Celery ====================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ==================== Logging ====================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log

# ==================== GraphQL ====================
GRAPHQL_ENABLED=true
GRAPHQL_SUBSCRIPTIONS_ENABLED=true

# ==================== API Gateway ====================
API_GATEWAY_ENABLED=true
API_GATEWAY_CACHE_ENABLED=true
API_GATEWAY_CACHE_TTL=300

# ==================== Monitoring Alerts ====================
SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=

# ==================== Domain ====================
DOMAIN=localhost
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
